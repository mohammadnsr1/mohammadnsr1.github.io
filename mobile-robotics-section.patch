@@ -950,6 +950,113 @@ a:focus-visible {
   box-shadow: 0 10px 22px rgba(var(--card-accent-rgb), 0.12);
 }
 
+.project-feature {
+  grid-column: 1 / -1;
+  --card-accent-rgb: var(--accent-teal-rgb);
+  --card-accent-2-rgb: var(--accent-cyan-rgb);
+}
+
+.project-feature .project-content {
+  padding: 1.9rem 2rem 2.1rem;
+}
+
+.project-feature-header {
+  display: grid;
+  gap: 0.7rem;
+  max-width: 68ch;
+}
+
+.project-feature-header .project-tag {
+  width: fit-content;
+}
+
+.project-feature-header h3 {
+  margin: 0.2rem 0 0;
+  font-size: 1.5rem;
+  line-height: 1.24;
+}
+
+.project-feature-header p {
+  margin: 0;
+}
+
+.mobile-skills {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.6rem;
+  padding: 0;
+  margin: 1.4rem 0 0;
+  list-style: none;
+}
+
+.mobile-subgrid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 1.1rem;
+  margin-top: 1.8rem;
+}
+
+.mobile-subcard {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  gap: 0.7rem;
+  padding: 1.2rem 1.25rem 1.35rem;
+  border: 1px solid rgba(var(--card-accent-rgb), 0.16);
+  border-radius: var(--radius-sm);
+  background: rgba(255, 255, 255, 0.02);
+}
+
+.mobile-subcard .project-tag {
+  width: fit-content;
+}
+
+.mobile-subcard h4 {
+  margin: 0.2rem 0 0;
+  font-size: 1.05rem;
+  line-height: 1.3;
+}
+
+.mobile-subcard p {
+  margin: 0;
+  font-size: 0.94rem;
+  color: var(--muted-strong);
+}
+
+.mobile-subcard dl {
+  margin: 0.3rem 0 0;
+  display: grid;
+  gap: 0.5rem;
+}
+
+.mobile-subcard dt {
+  color: rgb(var(--card-accent-rgb));
+  text-transform: uppercase;
+  letter-spacing: 0.1em;
+  font-size: 0.68rem;
+}
+
+.mobile-subcard dd {
+  margin: 0;
+  font-size: 0.88rem;
+}
+
+.mobile-subcard .project-links {
+  margin-top: auto;
+  padding-top: 0.95rem;
+}
+
+.mobile-subcard-pending {
+  border-style: dashed;
+  opacity: 0.7;
+}
+
+@media (max-width: 900px) {
+  .mobile-subgrid {
+    grid-template-columns: 1fr;
+  }
+}
+
 .theme-grid {
   grid-template-columns: repeat(2, minmax(0, 1fr));
 }
